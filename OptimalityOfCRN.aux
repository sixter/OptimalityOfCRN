\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Set $\alpha =2$ so that $B_1\sim \beta (2.5,1.5)$ and $F_{\beta }(0.5)= 0.288$. Set $B_2=1$ (its value is of little importance since it does not affect whether $B_1$ is increasing or not). In graph (A), the black line denotes $X_2(U_1,1)$ and the red line denotes $X'_2(U_1,1)$ when it is not equal to $X_2(U_1,1)$. Graph (C) represents the transformation $g(U_1)$ in red compared to the identity function. Graph (B) then imposes the flip that was applied by $g$ onto the values of $B_1$. Graph (A) shows the effect of the flip, $g$, through $B_1$ onto the value of $X_2$.}}{25}{figure.4}\protected@file@percent }
\newlabel{fig:ranlogmapflip}{{4}{25}{Set $\alpha =2$ so that $B_1\sim \beta (2.5,1.5)$ and $F_{\beta }(0.5)= 0.288$. Set $B_2=1$ (its value is of little importance since it does not affect whether $B_1$ is increasing or not). In graph (A), the black line denotes $X_2(U_1,1)$ and the red line denotes $X'_2(U_1,1)$ when it is not equal to $X_2(U_1,1)$. Graph (C) represents the transformation $g(U_1)$ in red compared to the identity function. Graph (B) then imposes the flip that was applied by $g$ onto the values of $B_1$. Graph (A) shows the effect of the flip, $g$, through $B_1$ onto the value of $X_2$}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces (A): Simulated density of $X_2=4B_2B_1(1-B_1)$ and $X''_2(U_1,B_2,\xi )$ (see Equation \ref {eq:X2gh}). The random variables $B_i\sim Beta(1.5,0.5), i\in \{1,2\}$, $U_1\sim \mathrm  {Unif}(0,1)$, $\xi \sim \text  {Bernoulli}(F_{\beta }(0.5))$ are independent. This shows that the random variable $X''_2$, which is based on the transformations $g$ and $h$ are indeed equimeasurable to $X_2$. (B): Comparison of the density of $X_2$ and $Y_2$ }}{26}{figure.5}\protected@file@percent }
\newlabel{fig:ranlogmapdensities}{{5}{26}{(A): Simulated density of $X_2=4B_2B_1(1-B_1)$ and $X''_2(U_1,B_2,\xi )$ (see Equation \ref {eq:X2gh}). The random variables $B_i\sim Beta(1.5,0.5), i\in \{1,2\}$, $U_1\sim \unif (0,1)$, $\xi \sim \text {Bernoulli}(F_{\beta }(0.5))$ are independent. This shows that the random variable $X''_2$, which is based on the transformations $g$ and $h$ are indeed equimeasurable to $X_2$. (B): Comparison of the density of $X_2$ and $Y_2$}{figure.5}{}}
\newlabel{eq:X2gh}{{15}{26}{Random Logistics Map}{equation.5.15}{}}
