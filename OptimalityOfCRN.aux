\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The simulated expected value of $|X_n-X'_n|$ where $X_n,X'_n$ are random logistic maps and CRN is applied ($X_0=0.5,X'_0=0.125$). For all $\alpha >1/2$, the chain converges in distribution. For $\alpha \geq 2$, the chain is geometrically ergodic. The CRN estimate uses the mean of $10 000$ simulations.}}{16}{figure.1}\protected@file@percent }
\newlabel{fig:randomlogmapcrn}{{1}{16}{The simulated expected value of $|X_n-X'_n|$ where $X_n,X'_n$ are random logistic maps and CRN is applied ($X_0=0.5,X'_0=0.125$). For all $\alpha >1/2$, the chain converges in distribution. For $\alpha \geq 2$, the chain is geometrically ergodic. The CRN estimate uses the mean of $10 000$ simulations}{figure.1}{}}
